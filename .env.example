# =============================================================================
# AgniNetra AI — Environment Configuration Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env with secrets to version control.
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_USER=agnietra
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=agnietra_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----- Backend -----
DATABASE_URL=postgresql://agnietra:change_me_in_production@localhost:5432/agnietra_db
SECRET_KEY=change_me_in_production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000

# ----- NASA FIRMS (register at https://firms.modaps.eosdis.nasa.gov/api/map_key/) -----
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area

# ----- OpenStreetMap Overpass -----
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ----- Google Earth Engine (Optional / Advanced) -----
EE_PROJECT_ID=
EE_SERVICE_ACCOUNT=
EE_PRIVATE_KEY=
EE_USE_MOCK_WHEN_MISSING=true
